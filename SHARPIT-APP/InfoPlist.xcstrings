{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt connects to your Bluetooth chest strap or armband to show your heart rate while you track strength training on your phone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHARPIT se connecte à ta ceinture ou ton brassard Bluetooth pour afficher ta fréquence cardiaque pendant le suivi muscu sur le téléphone."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With SharpIt Pro, your planned sessions are written to a “SharpIt” calendar and follow the changes to your plan. SharpIt never touches any other calendar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec SharpIt Pro, tes séances planifiées s'écrivent dans un calendrier « SharpIt » et suivent les changements de ton plan. SharpIt ne touche à aucun autre calendrier."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt uses the camera to read the barcode of the foods you add to your log. The images stay on your device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHARPIT utilise l'appareil photo pour lire le code-barres des aliments que tu ajoutes à ton journal. Les images restent sur ton appareil."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt reads your sleep, heart rate, HRV, steps and workouts from Apple Health to update your day as soon as your watch has synced."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHARPIT lit ton sommeil, ta fréquence cardiaque, ta VFC, tes pas et tes séances dans Apple Santé pour mettre à jour ton état du jour dès que ta montre a synchronisé."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt can write your day's food total (energy and macros) and the weight you log in the app to Apple Health, to keep them in line with Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHARPIT peut écrire dans Apple Santé le total de ta journée alimentaire (énergie et macros) et le poids que tu notes dans l'app, pour les garder alignés avec Santé."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt uses your location to show the Apple Weather forecast where you train."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHARPIT utilise ta position pour afficher la météo Apple du lieu où tu t'entraînes."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt uses the microphone so you can dictate your questions to the coach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHARPIT utilise le micro pour que tu dictes tes questions au coach."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SharpIt transcribes what you dictate to write it into your question to the coach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHARPIT transcrit ce que tu dictes pour l'écrire dans ta question au coach."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
