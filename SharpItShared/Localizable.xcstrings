            "state": "translated",
            "value": "Une demande (optionnel)"
          }
        }
      }
    },
    "Une douleur ou une blessure en cours ? Le coach adapte tes séances pour la ménager.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pain or an injury right now? The coach adapts your sessions to spare it."
          }
        },
        "fr": {
