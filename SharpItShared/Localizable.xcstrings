  "strings": {
    "": {},
    "\n\nTon abonnement SharpIt Pro continue de se renouveler : supprimer ton compte ne l'arrête pas. Annule-le d'abord pour ne plus être facturé.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nYour SharpIt Pro subscription keeps renewing: deleting your account doesn't stop it. Cancel it first so you're no longer billed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nTon abonnement SharpIt Pro continue de se renouveler : supprimer ton compte ne l'arrête pas. Annule-le d'abord pour ne plus être facturé."
          }
        }
      }
    },
    " — ils s'y règlent aussi.": {
