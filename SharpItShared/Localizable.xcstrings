    "Pour le calculer, il faut ta date de naissance, ton sexe et une VO₂max de moins de 90 jours (course ou vélo, lue sur ta montre).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To calculate it, we need your date of birth, your sex and a VO₂max under 90 days old (run or bike, read from your watch)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le calculer, il faut ta date de naissance, ton sexe et une VO₂max de moins de 90 jours (course ou vélo, lue sur ta montre)."
          }
        }
      }
    },
    "Pour qui ?": {
      "localizations": {
