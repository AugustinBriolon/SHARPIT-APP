// Where the app reaches the API. `//` starts a comment in an xcconfig, so the
// slashes of the scheme are split with an empty `$()`.
SHARPIT_API_ORIGIN = http:/$()/127.0.0.1:3001

// Locally the API is `apps/api` (port 3001) and the web pages are `apps/web` (port 3000), both
// started by `yarn dev` in SHARPIT-WEBAPP. Local.xcconfig can aim both at deployed hosts instead.
SHARPIT_WEB_ORIGIN = http:/$()/127.0.0.1:3000

// Per-machine override, gitignored. Put `SHARPIT_API_ORIGIN = https:/$()/…` there to run
// a Debug build on a phone against a deployed instance.
#include? "Local.xcconfig"

// Liquid Glass app icon, authored as `SHARPIT-APP/SharpIt.icon` (Icon Composer document).
ASSETCATALOG_COMPILER_APPICON_NAME = SharpIt
