// Where the app reaches the web app. `//` starts a comment in an xcconfig, so the
// slashes of the scheme are split with an empty `$()`.
SHARPIT_API_ORIGIN = http:/$()/127.0.0.1:3000

// Web pages follow the API origin locally. When Local.xcconfig aims the API at
// `api.sharpit.app`, set `SHARPIT_WEB_ORIGIN = https:/$()/sharpit.app` there too: `api.` serves no page.
SHARPIT_WEB_ORIGIN = $(SHARPIT_API_ORIGIN)

// Per-machine override, gitignored. Put `SHARPIT_API_ORIGIN = https:/$()/…` there to run
// a Debug build on a phone against a deployed instance.
#include? "Local.xcconfig"

// Liquid Glass app icon, authored as `SHARPIT-APP/SharpIt.icon` (Icon Composer document).
ASSETCATALOG_COMPILER_APPICON_NAME = SharpIt
